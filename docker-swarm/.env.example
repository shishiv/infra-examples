# Generic, non-secret configuration for this infrastructure example.
# Copy to .env in the module directory and edit the values for a real target.
# The example values are reserved/documentation-only values.

STACK_NAME=staging
EXPECTED_EDGE_IP=192.0.2.10
EDGE_NETWORK=edge-public
EDGE_SERVICE=edge-router
EDGE_CERT_RESOLVER=default

PUBLIC_WEB_HOST=app.example.test
PUBLIC_API_HOST=api.example.test
PUBLIC_DASHBOARD_HOST=dashboard.example.test
PUBLIC_SERVICE_HOST=service.example.test

REGISTRY_HOST=registry.example.invalid
REGISTRY_NAMESPACE=portfolio
REGISTRY_USERNAME=portfolio-user

# REGISTRY_TOKEN is intentionally not stored in this file.
# Supply it transiently to the one command that needs private registry access.
# Never commit or log its value.
