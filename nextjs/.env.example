# Public values are build-time inputs and are safe only when they contain no secret.
NEXT_PUBLIC_SITE_NAME=Portfolio Example
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_ANALYTICS_HOST=
NEXT_PUBLIC_POSTHOG_KEY=

# Server-only values stay out of browser bundles.
NODE_ENV=development
API_URL=http://localhost:4000
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DATABASE
JWT_SECRET=replace-with-a-random-value-at-least-32-characters

# Playwright may use a disposable local account. Keep these empty by default.
E2E_BASE_URL=http://localhost:3000
E2E_EMAIL=
E2E_PASSWORD=
